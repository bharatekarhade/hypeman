# Copy to .env (gitignored) and fill in. Read only by ./mvnw spring-boot:run (the local profile).
# Production sets these as real environment variables instead.

# The hypeman-backend IAM user's access key: allowed to use only the media bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1
HYPEMAN_MEDIA_BUCKET=

# Optional: the app's Apple ID from App Store Connect, to accept real App Store purchases (Sandbox works without it).
# HYPEMAN_APP_STORE_APP_APPLE_ID=

# Optional: the token for /v1/admin/** (32+ characters). Leave the line out to use the local default; set it empty and
# the admin endpoints are off.
# HYPEMAN_ADMIN_TOKEN=

# Optional: an APNs auth key, so friends get a push when someone yells at them. Without it pushes are skipped.
# HYPEMAN_PUSH_TEAM_ID=
# HYPEMAN_PUSH_KEY_ID=
# HYPEMAN_PUSH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
